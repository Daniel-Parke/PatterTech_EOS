{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pattertech.eos/wargame.schema.json",
  "title": "Unified EOS Wargame metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "summary",
    "kind",
    "type",
    "scenario_modes",
    "applies_when",
    "engages_when",
    "consequence",
    "relations",
    "sources",
    "review",
    "lifecycle"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^WG-[A-Z0-9]+-[0-9]{3}$"},
    "summary": {"type": "string", "minLength": 1},
    "kind": {"const": "wargame"},
    "type": {"const": "wargame"},
    "scenario_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["selection", "conflict", "exception", "gap"]}
    },
    "applicable_doctrines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DOC-[A-Z0-9]+-[0-9]{3}$"}
    },
    "gap_domain": {"type": "string", "minLength": 1},
    "applies_when": {"$ref": "#/$defs/strings"},
    "engages_when": {"$ref": "#/$defs/strings"},
    "consequence": {"enum": ["routine", "high"]},
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DREL-[A-Z0-9]+-[0-9]{3}$"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {"pattern": "^pending-"}
      }
    },
    "review": {"type": "string", "minLength": 1},
    "review_cohort": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "lifecycle": {
      "enum": ["draft", "experimental", "active", "contested", "superseded", "archived"]
    }
  },
  "anyOf": [
    {"required": ["applicable_doctrines"]},
    {"required": ["gap_domain"]}
  ],
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
