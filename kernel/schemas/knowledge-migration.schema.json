{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pattertech.eos/knowledge-migration.schema.json",
  "title": "Reviewed migration ledger for normative pack sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "baseline_commit", "inventory_sha256", "rows"],
  "properties": {
    "version": {"const": 1},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "path", "family", "ordinal", "start", "end", "block_sha256", "disposition", "reason"],
      "properties": {
        "source_key": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^packs/[^/]+/PACK\\.md$"},
        "family": {"enum": ["requirement", "default", "preference", "voice-scope"]},
        "ordinal": {"type": "integer", "minimum": 1},
        "start": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1},
        "block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "legacy_anchor": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["create", "merge_into", "retain_explanatory", "reject"]},
        "targets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DOC-[A-Z0-9]+-[0-9]{3}$"}},
        "destination": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"enum": ["create", "merge_into"]}}},
          "then": {"required": ["targets"], "properties": {"targets": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"disposition": {"const": "retain_explanatory"}}},
          "then": {"required": ["destination"]}
        }
      ]
    }
  }
}
