{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pattertech.eos/doctrine-source-inventory.schema.json",
  "title": "Frozen pre-migration Doctrine source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "schema_note",
    "authority_note",
    "baseline_commit",
    "inventory_sha256",
    "standard_inventory_sha256",
    "rows"
  ],
  "properties": {
    "version": {"const": 1},
    "kind": {"const": "doctrine-source-inventory"},
    "schema_note": {"type": "string", "minLength": 1},
    "authority_note": {"type": "string", "minLength": 1},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "standard_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_key",
        "path",
        "family",
        "ordinal",
        "start",
        "end",
        "block_sha256"
      ],
      "properties": {
        "source_key": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^packs/[^/]+/PACK\\.md$"},
        "family": {
          "enum": ["requirements", "defaults", "preferences", "voice-scope"]
        },
        "ordinal": {"type": "integer", "minimum": 1},
        "start": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1},
        "block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "legacy_anchor": {"type": "string", "minLength": 1},
        "preliminary_authority": {
          "enum": ["binding", "default", "advisory", "preference"]
        }
      }
    }
  }
}
