{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pattertech.eos/doctrine-relation.schema.json",
  "title": "Typed relation owned by an EOS Doctrine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner_doctrine",
    "relation",
    "target",
    "conditions",
    "status",
    "evidence",
    "fallback"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^DREL-[A-Z0-9]+-[0-9]{3}$"},
    "owner_doctrine": {"type": "string", "pattern": "^DOC-[A-Z0-9]+-[0-9]{3}$"},
    "relation": {
      "enum": ["depends_on", "supports", "tensions_with", "conflicts_with", "exception_to", "supersedes", "covers_gap"]
    },
    "target": {"type": "string", "minLength": 1},
    "conditions": {"$ref": "#/$defs/strings"},
    "status": {"enum": ["open", "active", "covered", "settled", "retired"]},
    "evidence": {"$ref": "#/$defs/strings"},
    "fallback": {"type": "string", "minLength": 1},
    "wargame": {"type": "string", "pattern": "^(GD|WG)-[A-Z0-9]+-[0-9]{3}$"},
    "owner": {"type": "string", "minLength": 1},
    "review": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"relation": {"const": "covers_gap"}}},
      "then": {
        "required": ["wargame"],
        "properties": {
          "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        }
      }
    }
  ],
  "$defs": {
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
